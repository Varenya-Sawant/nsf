# nsf .gitignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.vim/
.netrwhist

# Bash/Shell
*.bak
*.tmp
.bash_history
.bash_sessions

# Test artifacts
*.log
test-*.sh
test_output/
coverage/

# Build/Dist
build/
dist/
*.tar.gz
*.zip

# Dependencies (if used)
node_modules/
venv/
env/

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
/tmp/
temp/
*.temp

# Generated documentation
site/
_site/

# Debug files
debug.log
*.dmp

# OS specific
.AppleDouble
.LSOverride
.TemporaryItems
