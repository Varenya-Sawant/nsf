function log_info(string $msg): void  { echo "[INFO]  {$msg}" . PHP_EOL; }
function log_error(string $msg): void { fwrite(STDERR, "[ERROR] {$msg}" . PHP_EOL); }

// -----------------------------------------------------------------------------
// Main logic
// -----------------------------------------------------------------------------
function main(array $argv): int
{
    log_info('Starting {{NSF_BASENAME}}');

    try {
        // Your code here

        log_info('Done');
        return 0;
    } catch (Throwable $e) {
        log_error($e->getMessage());
        return 1;
    }
}

// -----------------------------------------------------------------------------
// Entry
// -----------------------------------------------------------------------------
exit(main($argv));
